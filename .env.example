# Local defaults. Never commit real secrets.
APP_ENV=development
APP_NAME=Octa Oracle
PUBLIC_BASE_URL=http://localhost:8088
MINI_APP_URL=http://localhost:8088
CORS_ORIGINS=http://localhost:8088,http://localhost:5173

# Local browser authentication. Production refuses to start with this enabled.
DEV_AUTH=true
DEV_TELEGRAM_USER_ID=1

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=3600
TELEGRAM_AUTO_SETUP=false

POSTGRES_DB=octa_oracle
POSTGRES_USER=octa_oracle
POSTGRES_PASSWORD=local-postgres-change-me

# mock works without a GPU; change to vllm and enable the gpu Compose profile.
LLM_MODE=mock
LLM_SYSTEM_PROMPT=Ты полезный ассистент. Отвечай на языке пользователя, точно и понятно.
LLM_TEMPERATURE=0.6
LLM_MAX_OUTPUT_TOKENS=4096
LLM_CONTEXT_CHAR_BUDGET=8000
SHOW_REASONING=false

VLLM_IMAGE=vllm/vllm-openai:latest
VLLM_BASE_URL=http://vllm:8000/v1
VLLM_MODEL_SOURCE=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B
VLLM_API_KEY=local-vllm-key
VLLM_MODEL=deepseek-r1-8b
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
HF_TOKEN=

MAX_INPUT_CHARS=16000
MAX_CONCURRENT_GENERATIONS_PER_USER=1
RATE_LIMIT_REQUESTS_PER_MINUTE=20
MOCK_CHUNK_DELAY_SECONDS=0.025

WEB_PORT=8088
API_PORT=8001
VLLM_PORT=8000
